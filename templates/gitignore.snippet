# Steam dev-only App ID stub. Valve recommends NOT shipping this file. Every dev machine needs its
# own copy (just the app id, "480" during development) at the project root for editor runs and
# non-Steam-launched exports.
/steam_appid.txt

# Temp copies Windows leaves when the editor holds the GodotSteam DLL during an addon update.
addons/godotsteam/**/~*.TMP
